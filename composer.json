{
  "name": "yotech-ai/twill-cms-redirects",
  "description": "Redirect management for Twill CMS, with a shared Plugins page for Yotech Twill packages",
  "keywords": ["twill", "laravel", "cms", "redirects", "twill-plugin"],
  "homepage": "https://github.com/Yotech-AI/twill-cms-redirects",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.1",
    "area17/twill": "^3.6"
  },
  "autoload": {
    "psr-4": {
      "TwillRedirects\\": "src"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "TwillRedirects\\TwillRedirectsServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
